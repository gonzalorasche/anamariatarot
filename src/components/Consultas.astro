---
import { SERVICIOS, CONDICIONES, VIGENCIA } from "../data/consultas";
---

<section class="consultas" id="consultas">
  <div class="wrap">
    <header class="cab" data-reveal>
      <div>
        <p class="kicker">Propuestas</p>
        <h2 class="display titulo">Consultas</h2>
      </div>
      <p class="vigencia">
        Precios vigentes a <strong>{VIGENCIA}</strong><br />
        <span class="moneda">Valores en pesos argentinos</span>
      </p>
    </header>

    <ul class="grilla">
      {
        SERVICIOS.map((s, i) => (
          <li
            class:list={["tarjeta", { destacada: s.destacada }]}
            data-reveal
            style={`--i: ${i + 1}`}
          >
            <div class="arriba">
              {s.destacada && (
                <span class="sello" aria-hidden="true">
                  ✦
                </span>
              )}
              <h3 class="nombre">{s.titulo}</h3>
              <p class="desc">{s.desc}</p>
            </div>

            <div class="precios">
              {s.meta && <p class="meta">{s.meta}</p>}
              <div class="lista">
                {s.precios.map((f) => (
                  <div class="fila">
                    <span>{f.t}</span>
                    <strong>{f.p}</strong>
                  </div>
                ))}
              </div>
              {s.nota && <p class="nota">{s.nota}</p>}
              {s.destacada && (
                <a class="consultar" href="#contacto">
                  Consultar disponibilidad
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    <ul class="condiciones" data-reveal>
      {
        CONDICIONES.map((c) => (
          <li>
            <span class="marca" aria-hidden="true">
              ✦
            </span>
            {c}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .consultas {
    padding-block: clamp(80px, 12vh, 150px);
    border-top: 1px solid var(--line);
  }

  .cab {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: clamp(26px, 3vw, 38px);
    border-bottom: 1px solid var(--line);
  }

  .titulo {
    font-size: clamp(38px, 5vw, 68px);
    margin-top: clamp(12px, 1.6vw, 18px);
  }

  .vigencia {
    font-size: 11.5px;
    line-height: 1.6;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mute);
    text-align: right;
  }

  .vigencia strong { color: var(--gold); font-weight: 500; }
  .moneda { font-size: 10.5px; letter-spacing: 0.08em; opacity: 0.8; }

  /* ---------- tarjetas ---------- */
  .grilla {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(238px, 1fr));
    gap: 1px;
    /* Las hairlines las dibuja cada tarjeta con su propia sombra, no el fondo
       de la grilla: si fuera el fondo, mientras las tarjetas están invisibles
       se vería un bloque gris entero al entrar la sección. */
    background: transparent;
  }

  .tarjeta {
    display: flex;
    flex-direction: column;
    gap: clamp(22px, 3vw, 34px);
    padding: clamp(28px, 3.2vw, 40px) clamp(22px, 2.4vw, 32px);
    background: var(--bone);
    box-shadow: 0 0 0 1px var(--line);
    transition: background 0.5s var(--ease);
  }

  .nombre {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.15;
    margin-bottom: 10px;
  }

  .desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 34ch;
  }

  .precios { margin-top: auto; }

  .fila {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 11px 0;
    border-top: 1px solid var(--line);
  }

  .fila span {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .fila strong {
    font-size: clamp(16px, 1.5vw, 18px);
    font-weight: 500;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .nota {
    margin-top: 14px;
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--ink-mute);
  }

  @media (hover: hover) and (pointer: fine) {
    .tarjeta:hover { background: var(--paper); }
    .tarjeta:hover .fila strong { color: var(--gold); }
    .tarjeta.destacada:hover { background: #1d1811; }
    .tarjeta.destacada:hover .fila strong { color: var(--gold-light); }
    .consultar:hover { gap: 14px; color: #fff; border-color: var(--gold-light); }
  }

  /* ---------- la tarjeta de eventos ----------
     Tiene un solo precio, así que al lado de las otras quedaba coja:
     va en oscuro y cierra la fila como un bloque propio. */
  .tarjeta.destacada {
    position: relative;
    background: var(--ink);
    color: var(--bone);
    overflow: hidden;
  }

  .tarjeta.destacada::after {
    content: "";
    position: absolute;
    right: -70px;
    top: -70px;
    width: 190px;
    height: 190px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(201, 164, 86, 0.22), transparent 68%);
    pointer-events: none;
  }

  .tarjeta.destacada .arriba { position: relative; }

  .sello {
    display: block;
    font-size: 15px;
    color: var(--gold-light);
    margin-bottom: 14px;
  }

  .tarjeta.destacada .nombre { color: var(--bone); }
  .tarjeta.destacada .desc { color: rgba(244, 239, 230, 0.6); }

  .meta {
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-light);
    padding-bottom: 14px;
  }

  .tarjeta.destacada .fila { border-color: rgba(244, 239, 230, 0.16); }
  .tarjeta.destacada .fila span { color: rgba(244, 239, 230, 0.55); }

  .tarjeta.destacada .fila strong {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(24px, 2.4vw, 30px);
    color: var(--bone);
  }

  .tarjeta.destacada .nota { color: rgba(244, 239, 230, 0.42); }

  .consultar {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 20px;
    padding-bottom: 7px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-light);
    border-bottom: 1px solid rgba(201, 164, 86, 0.45);
    transition: gap 0.4s var(--ease), color 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }

  .consultar::after { content: "→"; }

  /* en pantalla chica la vigencia baja debajo del título y alinea con todo */
  @media (max-width: 720px) {
    .cab {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .vigencia {
      text-align: left;
      line-height: 1.75;
    }
  }

  /* ---------- condiciones ---------- */
  .condiciones {
    list-style: none;
    display: grid;
    gap: 10px;
    margin-top: clamp(26px, 3vw, 36px);
  }

  .condiciones li {
    display: flex;
    gap: 12px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-mute);
  }

  .marca { color: var(--gold); font-size: 10px; line-height: 1.9; }
</style>
