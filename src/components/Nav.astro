---
const links = [
  { href: "#bio", label: "Ana María" },
  { href: "#consultas", label: "Consultas" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="nav">
  <div class="wrap bar">
    <a class="brand" href="#inicio" aria-label="Ana María Tarot, inicio">
      <img class="logo" src="/img/logo-dark.png" alt="Ana María Tarot" width="813" height="159" />
    </a>

    <nav class="links" aria-label="Secciones del sitio">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: var(--nav-h);
    padding-top: env(safe-area-inset-top);
    background: color-mix(in srgb, var(--bone) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.1);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s var(--ease);
  }

  /* el contenido del nav alinea contra el mismo eje que el resto del sitio */
  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: inline-flex;
    align-items: center;
  }

  .logo {
    height: clamp(22px, 2.6vw, 30px);
    width: auto;
  }

  .links {
    display: flex;
    gap: clamp(18px, 2.4vw, 38px);
  }

  .links a {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: color 0.35s var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .links a:hover { color: var(--gold); }
  }

  @media (max-width: 720px) {
    .links { display: none; }
  }
</style>
