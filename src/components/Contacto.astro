---
const whatsapp =
  "https://wa.me/5491154723434?text=" +
  encodeURIComponent(
    "Hola Ana María, vi tu web y me gustaría consultar por una lectura de Tarot."
  );
---

<section class="contacto" id="contacto">
  <div class="wrap inner" data-reveal>
    <p class="kicker">Inicia tu camino</p>

    <h2 class="display titulo">Escribime y<br />coordinamos</h2>

    <p class="intro">
      Si sentís el llamado a descubrir lo que las cartas tienen para revelarte,
      escribime directamente y acordamos día y horario.
    </p>

    <a class="btn wsp" href={whatsapp} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
        <path
          fill="currentColor"
          d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24M8.53 7.33c-.16 0-.43.06-.65.3-.23.24-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.72 2.75 4.23 3.74 2.09.82 2.52.66 2.97.62.46-.04 1.46-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.46-.28-.25-.12-1.46-.72-1.69-.8-.22-.09-.39-.13-.55.12-.16.25-.63.8-.77.96-.14.17-.28.19-.53.07-.25-.13-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.55-1.34-.76-1.84-.2-.48-.4-.41-.55-.42z"
        ></path>
      </svg>
      Escribir por WhatsApp
    </a>

    <p class="horario">Atención personalizada de lunes a sábados</p>
  </div>
</section>

<style>
  .contacto {
    position: relative;
    overflow: hidden;
    padding-block: clamp(84px, 14vh, 170px);
    border-top: 1px solid var(--line);
    text-align: center;
  }

  /* un halo tenue detrás del cierre, el mismo gesto que en el hero */
  .contacto::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(880px, 92vw);
    aspect-ratio: 1;
    translate: -50% -50%;
    background: radial-gradient(
      circle,
      rgba(201, 164, 86, 0.14),
      rgba(201, 164, 86, 0.04) 44%,
      transparent 66%
    );
    pointer-events: none;
  }

  .inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .titulo {
    font-size: clamp(40px, 6vw, 80px);
    margin: clamp(14px, 1.8vw, 22px) 0 clamp(18px, 2vw, 26px);
  }

  .intro {
    font-size: clamp(15px, 1.25vw, 17.5px);
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 46ch;
    margin-bottom: clamp(30px, 3.4vw, 42px);
  }

  .wsp { gap: 12px; }

  .horario {
    margin-top: clamp(20px, 2.4vw, 26px);
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  @media (max-width: 600px) {
    .wsp { width: 100%; }
  }
</style>
